# Local-only server settings. Keep this file free of real credentials.

# --- Provedor de IA ativo -----------------------------------------------
# Escolha um: azure-openai | minimax | openai | anthropic | gemini
# (openai, anthropic e gemini chegam em fases seguintes desta refatoração.)
AI_PROVIDER=azure-openai

# Opcional: sobrescreve o provedor de um recurso específico, útil quando o
# provedor escolhido em AI_PROVIDER não cobre esse recurso (ex.: Anthropic
# não tem TTS/STT/vídeo). Vazio = usa AI_PROVIDER.
# AI_CHAT_PROVIDER=
# AI_VISION_PROVIDER=
# AI_TTS_PROVIDER=
# AI_STT_PROVIDER=
# AI_VIDEO_PROVIDER=

# --- Azure OpenAI --------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Alias accepted by the local provider.
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL_NAME=gpt-4o

# YouTube Data API v3 (server-only; nunca use VITE_). Crie uma chave no Google Cloud,
# habilite YouTube Data API v3 e restrinja a chave ao backend quando publicar.
YOUTUBE_API_KEY=

# --- Estúdio da Matéria: recursos extras (server-only, nunca VITE_) ---
# TTS: podcast, narração da vídeo aula e áudio-resumo. Deployment de gpt-4o-mini-tts (ou tts-hd).
# (as vozes por locutor são escolhidas no cliente em services/audio.js)
AZURE_OPENAI_TTS_DEPLOYMENT=
AZURE_OPENAI_TTS_API_VERSION=2025-04-01-preview
# Sora: clipe de abertura da vídeo aula (opcional; sem isto usa title card). Deployment de sora.
AZURE_OPENAI_SORA_DEPLOYMENT=
AZURE_OPENAI_VIDEO_API_VERSION=preview
# Transcrição (STT): pergunta por voz. Deployment de gpt-4o-transcribe (ou whisper).
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIBE_API_VERSION=2025-04-01-preview

# --- OpenAI (api.openai.com direto) --------------------------------------
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_TTS_MODEL=
# OPENAI_TRANSCRIBE_MODEL=
# OPENAI_VIDEO_MODEL=

# --- Anthropic (Claude) ---------------------------------------------------
# Somente chat/visão — sem TTS, STT ou geração de vídeo nativos.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Google Gemini ---------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=
# GEMINI_TTS_MODEL=
# GEMINI_VIDEO_MODEL=

# --- MiniMax -----------------------------------------------------------
# Sem TTS síncrono via STT (transcrição) confirmado — chat/visão, TTS e vídeo
# funcionam; AI_STT_PROVIDER precisa apontar para outro provedor.
# MINIMAX_API_KEY=
# Troque para https://api.minimaxi.com se sua conta for da região China continental.
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_TTS_BASE_URL=https://api-uw.minimax.io
# MINIMAX_CHAT_MODEL=MiniMax-M3
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
# Vozes por papel (A/B/narrator) — confira o catálogo real da sua conta.
# MiniMax não distingue português do Brasil de Portugal na API — são vozes
# "Portuguese" genéricas. Troque pelo voice_id que soar melhor para você;
# GET /v1/get_voice (voice_type=system) lista todas as ~69 opções em português.
# MINIMAX_VOICE_A=Portuguese_ChattyGirl
# MINIMAX_VOICE_B=Portuguese_WiseScholar
# MINIMAX_VOICE_NARRATOR=Portuguese_Narrator

# false makes the local API call the configured AI_PROVIDER.
JOVI_LENS_DEMO_MODE=false
VITE_JOVI_LENS_DEMO_MODE=false

# Optional local API binding.
JOVI_API_HOST=127.0.0.1
JOVI_API_PORT=8787
JOVI_WEB_URL=http://127.0.0.1:5173
