# Local-only server settings. Keep this file free of real credentials.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Alias accepted by the local provider.
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL_NAME=gpt-4o

# false makes the local API call Azure OpenAI.
JOVI_LENS_DEMO_MODE=false
VITE_JOVI_LENS_DEMO_MODE=false

# Optional local API binding.
JOVI_API_HOST=127.0.0.1
JOVI_API_PORT=8787
JOVI_WEB_URL=http://127.0.0.1:5173
