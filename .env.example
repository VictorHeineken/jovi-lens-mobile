# Server-only: configure in Vercel Environment Variables. Never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GOOGLE_CLIENT_ID=

# Public build-time values used by the browser.
VITE_GOOGLE_CLIENT_ID=

# Optional real billing checkout URL (Stripe, Mercado Pago, etc.).
# If omitted, the app explicitly says billing is not configured instead of simulating a purchase.
VITE_BILLING_CHECKOUT_URL=
